generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DishCategory {
  PLATO_UNICO
  PRIMERO
  SEGUNDO
  ACOMPANAMIENTO
}

enum DishMealType {
  COMIDA
  CENA
  AMBAS
}

enum DishSeason {
  VERANO
  INVIERNO
  AMBAS
}

enum MealSlot {
  COMIDA
  CENA
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  isAdmin      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  dishes       Dish[]
  weeklyMenus  WeeklyMenu[]
}

model Dish {
  id             String           @id @default(cuid())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  category       DishCategory
  mealType       DishMealType
  season         DishSeason       @default(AMBAS)
  yieldsTwoMeals Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ingredients    DishIngredient[]
  menuEntries    MenuEntry[]

  @@index([userId, category, mealType])
}

model DishIngredient {
  id       String  @id @default(cuid())
  dish     Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId   String
  name     String
  quantity Float?
  unit     String?
  order    Int     @default(0)

  @@index([dishId])
}

model WeeklyMenu {
  id        String              @id @default(cuid())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  weekStart DateTime            @db.Date
  createdAt DateTime            @default(now())
  entries   MenuEntry[]
  checks    ShoppingListCheck[]

  @@unique([userId, weekStart])
}

model MenuEntry {
  id           String       @id @default(cuid())
  weeklyMenu   WeeklyMenu   @relation(fields: [weeklyMenuId], references: [id], onDelete: Cascade)
  weeklyMenuId String
  dayOfWeek    Int
  mealType     MealSlot
  slot         DishCategory
  dish         Dish         @relation(fields: [dishId], references: [id])
  dishId       String
  leftoverOf   MenuEntry?   @relation("Leftover", fields: [leftoverOfId], references: [id], onDelete: Cascade)
  leftoverOfId String?
  leftoverCopy MenuEntry[]  @relation("Leftover")

  @@unique([weeklyMenuId, dayOfWeek, mealType, slot])
  @@index([weeklyMenuId])
}

model ShoppingListCheck {
  id           String     @id @default(cuid())
  weeklyMenu   WeeklyMenu @relation(fields: [weeklyMenuId], references: [id], onDelete: Cascade)
  weeklyMenuId String
  itemKey      String
  checked      Boolean    @default(false)

  @@unique([weeklyMenuId, itemKey])
}
