POSTGRES_USER=automenu
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-segura
POSTGRES_DB=automenu

NEXTAUTH_URL=http://localhost:3001
# Genera uno nuevo con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-esto-por-un-secreto-aleatorio

# Usuario que se crea automáticamente al arrancar (si no existe)
SEED_USERNAME=admin
SEED_PASSWORD=cambia-esto-por-una-contraseña-segura

APP_PORT=3001
DB_PORT=5433

# Despliegue remoto (scripts/deploy.sh)
# DEPLOY_HOST debe ser un Host definido en ~/.ssh/config
DEPLOY_HOST=nubito
DEPLOY_PATH=/home/ubuntu/automenu

# Puerto donde Caddy escucha HTTP en el servidor remoto. automenu convive
# en el mismo EC2 que trip2millionaire, que ya ocupa 80/443 con su propio
# Caddy, así que este usa un puerto alternativo.
CADDY_PORT=8443

# Hostname público. Es la misma IP de EC2 que trip2millionaire (vía
# sslip.io), solo cambia el puerto. De momento se sirve por HTTP plano
# (sin TLS): recuerda abrir el puerto CADDY_PORT en el Security Group.
DOMAIN=46-51-188-135.sslip.io
